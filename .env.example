SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_BUYER_COUNTRY=ES

# Usa uno de estos tokens. El privado es preferible porque nunca sale del servidor.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Relación entre cada pieza/talla de VÄLR y la variante publicada en Shopify.
# Debe estar en una sola línea cuando se copie a Vercel.
SHOPIFY_VARIANT_MAP={"hrafn-oversized-tee":{"S":"gid://shopify/ProductVariant/0000000001","M":"gid://shopify/ProductVariant/0000000002","L":"gid://shopify/ProductVariant/0000000003","XL":"gid://shopify/ProductVariant/0000000004"}}

# Newsletter del footer ("Únete al clan"): usa la Admin API de Shopify para
# crear/actualizar clientes con consentimiento de marketing por email.
# Es un token distinto del Storefront de arriba — créalo en Shopify como app
# personalizada con el scope write_customers.
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_ADMIN_API_TOKEN=
